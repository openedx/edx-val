# Exclude development, test, and CI folders
prune .github
prune src/edxval/settings
prune src/edxval/tests/data

# Exclude root level configuration and build files
exclude .gitignore
exclude Makefile
exclude catalog-info.yaml
exclude db_keyword_overrides.yml
exclude manage.py
exclude openedx.yaml
exclude pylintrc
exclude pylintrc_tweaks
exclude tox.ini
exclude urls.py
exclude uv.lock

# Exclude test/coverage artifacts
prune htmlcov
prune html_coverage
global-exclude .coverage
global-exclude coverage.xml
